; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="The Lost Choir"
run/main_scene="res://scenes/levels/Zone.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/state/game_state.gd"
WarmthField="*res://scripts/state/warmth_field.gd"
AudioDirector="*res://scripts/audio/audio_director.gd"
ZoneManager="*res://scripts/levels/zone_manager.gd"
PlaceholderLegibility="*res://scripts/art/placeholder_legibility.gd"
DebugOverlay="*res://scenes/debug_overlay.tscn"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"

